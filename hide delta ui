local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local player = Players.LocalPlayer

local hui = gethui()
local deltaLogo

-- Find the Delta logo ImageButton once
for _, v in pairs(hui:GetDescendants()) do
    if v:IsA("ImageButton") and tostring(v.Image):find("new_logo") then
        deltaLogo = v
        break
    end
end

local logoVisible = true  -- starts visible

local function setLogoVisible(state)
    if deltaLogo then
        logoVisible = state
        deltaLogo.Visible = logoVisible
    end
end

-- Listen for chat messages
TextChatService.OnIncomingMessage = function(message)
    if message.TextSource and message.TextSource.UserId == player.UserId then
        if message.Text == "..." then
            setLogoVisible(false) -- hide
        elseif message.Text == ".." then
            setLogoVisible(true) -- show
        end
    end
end